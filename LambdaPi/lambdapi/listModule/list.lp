require open Stdlib.Prop;
require open Stdlib.Set;
require open Stdlib.Eq;
require open listModule.nat;

// A dependently typed list definition called
// ilist, used to have compile time safety.
(A : Set) inductive ilist : TYPE ≔
| Nil : ilist A
| Cons : τ A → ilist A → ilist A;

constant symbol Bool : Set;
constant symbol true : τ Bool;
constant symbol false : τ Bool;

// We are defining the prod ourselves because
// The one in Stdlib uses a horrendous symbol
constant symbol x : Set → Set → Set;
notation x infix right 10;

(A : Set) (B : Set) inductive prod : TYPE ≔
| pair : τ A → τ B → prod A B;

// We are writing this Fin to represent
// natural numbers strictly less than n.
// So it is impossible to have an out of bounds
// error in the n_th function
constant symbol Fin : τ N → TYPE;
constant symbol FZero [n : τ N] : Fin (succ n);
constant symbol FSucc [n : τ N] : Fin n → Fin (succ n);

rule τ ($A x $B) ↪ prod $A $B;

// A length-indexed list vec
constant symbol vec : Set → τ N → TYPE;
constant symbol VNil [A : Set] : vec A zero;
constant symbol VCons [A : Set] [n : τ N] : τ A → vec A n → vec A (succ n);

// Set-level code for vec
constant symbol vecS : Set → τ N → Set;
rule τ (vecS $A $n) ↪ vec $A $n;

// Induction principle for vec using vecS
symbol ind_vec : Π A : Set, Π p : (Π n : τ N, τ (vecS A n) → Prop),
               π (p zero VNil) →
               (Π h : τ A, Π n : τ N, Π v : τ (vecS A n), π (p n v) → π (p (succ n) (VCons h v))) →
               Π n : τ N, Π v : τ (vecS A n), π (p n v);

// Remark : ind_vec is marked as an axiom.
// As a consequence of this, Lambdapi does not generate
// proofs if we were to use it during a proof with refine.
// So it may not be used to prove properties about vec.
// Proofs are realised on ilist, whose induction principale
// is automatically generated by the inductive command.
// (see ilist.lp)     
          
// Functions

// The function app takes two lists,
// returns the appended list
symbol app [A : Set] [n : τ N] [m : τ N] : vec A n → vec A m → vec A (n + m);

rule app VNil $l ↪ $l;
rule app (VCons $h $tl) $l ↪ VCons $h (app $tl $l);

// The function isnoc takes an element & a list,
// returns the list with the element added to its tail.
symbol isnoc [A : Set] [n : τ N] : τ A → vec A n → vec A (succ n);

rule isnoc $e (VNil) ↪ VCons $e VNil;
rule isnoc $e (VCons $h $tl) ↪ VCons $h (isnoc $e $tl);

// The function rev takes a list & returns the reversed list.
symbol rev [A : Set] [n : τ N] : vec A n → vec A n;

rule rev VNil ↪ VNil;
rule rev (VCons $h $tl) ↪ isnoc $h (rev $tl);

// The function that returns the first element of a list
symbol hd [A : Set] [n : τ N] : vec A (succ n) → τ A;

rule hd (VCons $h _) ↪ $h;

// The function that returns the tail of a list
symbol tl [A : Set] [n : τ N]  : vec A (succ n) → vec A n;

rule tl (VCons _ $tl) ↪ $tl;

// The function takes as argument a function f and an indexed list,
// applies this function to the elements of the list and
// sends the new list
symbol map [A : Set] [B : Set] [n : τ N] :  (τ A → τ B) → vec A n → vec B n;

rule map _ VNil ↪ VNil;
rule map $f (VCons $h $tl) ↪ VCons ($f $h) (map $f $tl);

// The function zip combines two lists of the same length into a list of pairs.
symbol zip [A : Set] [B : Set]  [n : τ N] : vec A n → vec B n → vec (A x B) n;

rule zip _ VNil ↪ VNil;
rule zip (VCons $h1 $tl1) (VCons $h2 $tl2) ↪ VCons (pair $h1 $h2) (zip $tl1 $tl2);

// The function returns the element at the given index.
// The type of the index is Fin n, which returns values
// strictly less than n (the length of the list).
symbol nth [A : Set ] [n : τ N] : Fin n → vec A n → τ A;

rule nth FZero (VCons $h _) ↪ $h;
rule nth (FSucc $i) (VCons _ $tl) ↪ nth $i $tl; 

// An auxiliary function to help with the filter function
symbol filter_aux [A : Set] : τ A → ilist A → τ Bool → ilist A;

rule filter_aux $h $tl true ↪ Cons $h $tl;
rule filter_aux _ $tl false ↪ $tl;

// The function filter keeps only the elements of a list
// satisfying a given boolean predicate, returns a ilist instead of
// a length indexed list because we do not know how many elements
// will satisfy the predicate.
symbol filter [A : Set] [n : τ N] : (τ A → τ Bool) → vec A n → ilist A;

rule filter _ VNil ↪ Nil;
rule filter $f (VCons $h $tl) ↪ filter_aux $h (filter $f $tl) ($f $h);

